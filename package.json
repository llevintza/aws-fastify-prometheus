{
  "name": "@llevintza/fastify-prometheus-metrics",
  "version": "3.0.0",
  "description": "A comprehensive Fastify plugin for Prometheus metrics collection with AWS CloudWatch integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --reporters=jest-junit",
    "type-check": "tsc --noEmit",
    "audit": "yarn npm audit --all --recursive",
    "audit:summary": "yarn npm audit --all --recursive --json | jq '.vulnerabilities | length' || echo 'jq not available'",
    "security": "yarn audit",
    "security:analyze": "./scripts/security-check.sh",
    "prepare": "node .husky/install.mjs",
    "prepublishOnly": "yarn clean && yarn build && yarn test",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "fastify",
    "prometheus",
    "metrics",
    "aws",
    "cloudwatch",
    "monitoring",
    "observability",
    "nodejs",
    "typescript",
    "plugin"
  ],
  "author": "llevintza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/llevintza/aws-fastify-prometheus.git"
  },
  "bugs": {
    "url": "https://github.com/llevintza/aws-fastify-prometheus/issues"
  },
  "homepage": "https://github.com/llevintza/aws-fastify-prometheus#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.6.0",
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.0",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.1.2",
    "@opentelemetry/api": "^1.10.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.0.1",
    "fastify": "^5.5.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.1.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^26.0.1",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.859.0",
    "fastify-plugin": "^6.0.1",
    "prom-client": "^15.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
